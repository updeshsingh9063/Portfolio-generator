# ============================================================================
# Folio — environment variables. Copy this file to `.env.local` and fill in.
# `.env.local` is git-ignored. Never commit real secrets.
# ============================================================================

# ---- App --------------------------------------------------------------------
# Root URL of the app (used for absolute links, OG images, auth callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The public root domain portfolios live under (for the URL preview + subdomains later).
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ---- Database (Supabase Postgres) ------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543, ?pgbouncer=true)
# and the "Session"/direct URL for DIRECT_URL (port 5432).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---- Supabase (Storage for images / résumés) -------------------------------
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # server-only; never expose to the client

# ---- Auth (Auth.js / NextAuth v5) ------------------------------------------
# Generate a secret: `npx auth secret`  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth — https://console.cloud.google.com → Credentials → OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- AI enhancement (Groq) -------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
